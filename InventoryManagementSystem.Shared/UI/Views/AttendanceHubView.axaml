<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:InventoryManagementSystem.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="InventoryManagementSystem.UI.Views.AttendanceHubView"
             x:DataType="vm:AttendanceHubViewModel">

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Margin="20,8,20,12">
            <Grid ColumnDefinitions="Auto, *">
                <TextBlock Text="Attendance &amp; Leave" FontSize="22" FontWeight="Bold" Margin="0,0,24,0" VerticalAlignment="Center"/>
                <Border Grid.Column="1" Background="{DynamicResource NavHoverColor}" CornerRadius="8" Padding="4" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Content="Attendance" Command="{Binding SwitchTabCommand}" CommandParameter="Attendance"
                                Classes="tab-btn" Classes.active-tab="{Binding IsAttendanceTab}"/>
                        <Button Content="Leave Requests" Command="{Binding SwitchTabCommand}" CommandParameter="Leave"
                                Classes="tab-btn" Classes.active-tab="{Binding IsLeaveTab}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ContentControl Grid.Row="1" Content="{Binding CurrentTab}"/>
    </Grid>
</UserControl>
