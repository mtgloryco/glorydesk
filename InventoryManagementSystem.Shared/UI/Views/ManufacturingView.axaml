<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:InventoryManagementSystem.UI.ViewModels"
             xmlns:domain="clr-namespace:InventoryManagementSystem.Domain"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="InventoryManagementSystem.UI.Views.ManufacturingView"
             x:DataType="vm:ManufacturingViewModel">
    <Grid>
        <TabControl SelectedIndex="{Binding SelectedTabIndex}" Margin="10">
        <!-- ==================== TAB 1: BILLS OF MATERIALS ==================== -->
        <TabItem Header="Bill of Materials (BoM)">
            <Grid Margin="10">
                <!-- STATE 1: BOM LIST VIEW -->
                <Grid RowDefinitions="Auto,Auto,*" IsVisible="{Binding !IsFormVisible}">
                    <!-- Header Panel -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,16">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Bills of Materials" FontSize="20" FontWeight="Bold" />
                            <TextBlock Text="Define and configure production recipes and ingredient list for goods." FontSize="11" Foreground="Gray" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="+ New BoM" Command="{Binding ShowCreateBomFormCommand}" Background="{DynamicResource NavActiveBgColor}" Foreground="{DynamicResource NavActiveTextColor}" Padding="14,6" FontWeight="SemiBold" CornerRadius="6" />
                    </Grid>

                    <!-- Search Bar -->
                    <Border Grid.Row="1" Background="{DynamicResource CardBackgroundColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,12">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBox Grid.Column="0" Text="{Binding SearchText}" Watermark="Search recipes by name, reference, type or company..." VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" Padding="5,0"/>
                            <TextBlock Grid.Column="1" Text="🔍" VerticalAlignment="Center" Margin="5,0" Foreground="Gray"/>
                        </Grid>
                    </Border>

                    <!-- DataGrid list -->
                    <Border Grid.Row="2" Background="{DynamicResource CardBackgroundColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="12">
                        <DataGrid ItemsSource="{Binding Boms}" SelectedItem="{Binding SelectedBom}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Final Product" Binding="{Binding ProductName}" Width="2*" />
                                <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="*" />
                                <DataGridTextColumn Header="BoM Type" Binding="{Binding BomType}" Width="*" />
                                <DataGridTextColumn Header="Company" Binding="{Binding Company}" Width="*" />
                                <DataGridTextColumn Header="Destination Location" Binding="{Binding DestinationLocationName}" Width="*" />
                                <DataGridTemplateColumn Header="Actions" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                <Button Content="Open / Edit" Command="{Binding $parent[UserControl].((vm:ManufacturingViewModel)DataContext).OpenBomDetailCommand}" CommandParameter="{Binding}"
                                                        Background="{DynamicResource ContentBackgroundColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" FontSize="11" FontWeight="SemiBold" Padding="8,3" CornerRadius="4"/>
                                                <Button Content="Delete" Command="{Binding $parent[UserControl].((vm:ManufacturingViewModel)DataContext).DeleteBomCommand}" CommandParameter="{Binding}"
                                                        Background="#14EF4444" Foreground="#EF4444" BorderBrush="#33EF4444" BorderThickness="1" FontSize="11" FontWeight="SemiBold" Padding="8,3" CornerRadius="4"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <!-- STATE 2: FULL-SCREEN BoM DETAIL FORM VIEW -->
                <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsFormVisible}">
                    <!-- Form Header & Actions -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,16">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                            <Button Content="← Back to Recipes" Command="{Binding CloseFormCommand}" Background="Transparent" Foreground="{DynamicResource NavActiveBgColor}" Padding="0" VerticalAlignment="Center" FontSize="13"/>
                            <TextBlock Text="/" Foreground="Gray" VerticalAlignment="Center" FontSize="13"/>
                            <TextBlock Text="{Binding Reference, FallbackValue='New Recipe'}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                            <Button Content="Discard" Command="{Binding CloseFormCommand}" Padding="14,6" FontSize="13" CornerRadius="6"/>
                            <Button Content="Save Recipe" Command="{Binding SaveBomCommand}" Background="{DynamicResource NavActiveBgColor}" Foreground="{DynamicResource NavActiveTextColor}" Padding="16,6" FontSize="13" FontWeight="SemiBold" CornerRadius="6"/>
                        </StackPanel>
                    </Grid>

                    <!-- Card Editor Sheet -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Border Background="{DynamicResource CardBackgroundColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="16">
                                <!-- Alert Banner -->
                                <Border Background="#FFEBEE" BorderBrush="#FFCDD2" BorderThickness="1" CornerRadius="4" Padding="10" IsVisible="{Binding HasError}">
                                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#B71C1C" FontSize="12" TextWrapping="Wrap"/>
                                </Border>

                                <!-- Header Grid -->
                                <Grid ColumnDefinitions="*, *" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                                    <!-- Product to Manufacture -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="5" Margin="0,0,16,12">
                                        <TextBlock Text="Product to Manufacture" FontSize="11" FontWeight="SemiBold" Foreground="Gray"/>
                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBox Grid.Column="0" Text="{Binding FinalProductSearchText, Mode=TwoWay}" Watermark="Type to search product to manufacture..."/>
                                            <Button Grid.Column="1" Content="+ New Product" Command="{Binding OpenCreateFinalProductCommand}" Margin="6,0,0,0" FontSize="11" FontWeight="SemiBold" Background="{DynamicResource NavActiveBgColor}" Foreground="{DynamicResource NavActiveTextColor}" CornerRadius="4" Padding="10,5"/>
                                        </Grid>

                                        <!-- Autocomplete dropdown list -->
                                        <ListBox ItemsSource="{Binding MatchedFinalProducts}"
                                                 IsVisible="{Binding IsFinalProductDropdownVisible}"
                                                 MaxHeight="140"
                                                 Background="{DynamicResource CardBackgroundColor}"
                                                 BorderBrush="{DynamicResource BorderColor}"
                                                 BorderThickness="1"
                                                 CornerRadius="4">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate DataType="domain:Product">
                                                    <Grid ColumnDefinitions="*, Auto, Auto" Margin="4,2">
                                                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="4,2"
                                                                Command="{Binding $parent[UserControl].((vm:ManufacturingViewModel)DataContext).SelectFinalProductCommand}" CommandParameter="{Binding .}">
                                                            <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                        </Button>
                                                        <TextBlock Grid.Column="1" Text="{Binding SKU, StringFormat='SKU: {0}'}" Foreground="Gray" FontSize="10" VerticalAlignment="Center" Margin="8,0" IsVisible="{Binding SKU, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                        <Button Grid.Column="2" Content="Select" Command="{Binding $parent[UserControl].((vm:ManufacturingViewModel)DataContext).SelectFinalProductCommand}" CommandParameter="{Binding .}" FontSize="10" Padding="8,3" CornerRadius="3"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <!-- Selected Product Indicator -->
                                        <Border Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,2,0,0" IsVisible="{Binding SelectedFinalProduct, Converter={x:Static ObjectConverters.IsNotNull}}">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="✓" Foreground="#2E7D32" FontWeight="Bold" FontSize="12"/>
                                                    <TextBlock Text="{Binding SelectedFinalProduct.Name, FallbackValue=''}" FontWeight="SemiBold" FontSize="12" Foreground="#1B5E20"/>
                                                    <TextBlock Text="{Binding SelectedFinalProduct.SKU, StringFormat='({0})', FallbackValue=''}" FontSize="11" Foreground="#388E3C" IsVisible="{Binding SelectedFinalProduct.SKU, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="✕" Command="{Binding ClearFinalProductCommand}" Background="Transparent" BorderThickness="0" Foreground="#2E7D32" Padding="4,0" Cursor="Hand" ToolTip.Tip="Clear selection"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <!-- Product Variant -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="5" Margin="0,0,16,12">
                                        <TextBlock Text="Product Variant" FontSize="11" FontWeight="SemiBold" Foreground="Gray"/>
                                        <TextBox Text="No variants configured" IsEnabled="False" Foreground="Gray"/>
                                    </StackPanel>

                                    <!-- Quantity -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Spacing="5" Margin="0,0,16,12">
                                        <TextBlock Text="Quantity to Produce" FontSize="11" FontWeight="SemiBold" Foreground="Gray"/>
                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBox Grid.Column="0" Text="{Binding Quantity}" Watermark="1.0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding SelectedFinalProduct.Unit, FallbackValue='Units'}" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray" FontWeight="SemiBold"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Reference -->
                                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="5" Margin="16,0,0,12">
                                        <TextBlock Text="Reference" FontSize="11" FontWeight="SemiBold" Foreground="Gray"/>
                                        <TextBox Text="{Binding Reference}" Watermark="BOM-001"/>
                                    </StackPanel>

                                    <!-- BoM Type -->
                                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="5" Margin="16,0,0,12">
                                        <TextBlock Text="BoM Type" FontSize="11" FontWeight="SemiBold" Foreground="Gray"/>
                                        <StackPanel Orientation="Horizontal" Spacing="24" Margin="0,8,0,0">
                                            <RadioButton Content="Manufacture this product" IsChecked="{Binding IsManufactureType}" GroupName="BomTypeGroup"/>
                                            <RadioButton Content="Kit" IsChecked="{Binding IsKitType}" GroupName="BomTypeGroup"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Company -->
                                    <StackPanel Grid.Row="2" Grid.Column="1" Spacing="5" Margin="16,0,0,12">
                                        <TextBlock Text="Company" FontSize="11" FontWeight="SemiBold" Foreground="Gray"/>
                                        <TextBox Text="{Binding Company}" Watermark="Company name"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Spacing="5" Margin="0,0,0,12">
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                            <StackPanel Spacing="5">
                                                <TextBlock Text="Yield %" FontSize="11" FontWeight="SemiBold" Foreground="Gray"/>
                                                <TextBox Text="{Binding YieldPercent}" Watermark="100"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="5">
                                                <TextBlock Text="Scrap %" FontSize="11" FontWeight="SemiBold" Foreground="Gray"/>
                                                <TextBox Text="{Binding ScrapPercent}" Watermark="0"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Finished Goods Destination Location -->
                                    <StackPanel Grid.Row="4" Grid.Column="0" Spacing="5" Margin="0,0,16,12">
                                        <TextBlock Text="Finished Goods Location" FontSize="11" FontWeight="SemiBold" Foreground="Gray"/>
                                        <Grid ColumnDefinitions="*, Auto">
                                            <ComboBox Grid.Column="0" ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedBomDestinationLocation}" HorizontalAlignment="Stretch" PlaceholderText="Select destination location...">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button Grid.Column="1" Content="Clear" Command="{Binding ClearBomDestinationLocationCommand}" Margin="6,0,0,0" Padding="8,4" FontSize="11"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <TabControl Margin="0,10,0,0">
                                    <TabItem Header="Components">
                                        <Border BorderThickness="0" Padding="0,12,0,0">
                                            <DockPanel>
                                                <!-- Bottom Add Row Button -->
                                                <Button DockPanel.Dock="Bottom" Content="+ Add a line" Command="{Binding AddComponentLineCommand}" Background="Transparent" Foreground="{DynamicResource NavActiveBgColor}" FontWeight="SemiBold" FontSize="12" Margin="0,6,0,0"/>

                                                <StackPanel Spacing="6">
                                                    <!-- Table Header -->
                                                    <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="0,4,0,8">
                                                        <Grid ColumnDefinitions="3*, 1*, 1*, 1*, Auto">
                                                            <TextBlock Grid.Column="0" Text="Component" FontWeight="SemiBold" FontSize="12" Foreground="Gray"/>
                                                            <TextBlock Grid.Column="1" Text="Quantity" FontWeight="SemiBold" FontSize="12" Foreground="Gray" Margin="10,0"/>
                                                            <TextBlock Grid.Column="2" Text="Scrap %" FontWeight="SemiBold" FontSize="12" Foreground="Gray" Margin="10,0"/>
                                                            <TextBlock Grid.Column="3" Text="Unit" FontWeight="SemiBold" FontSize="12" Foreground="Gray" Margin="10,0"/>
                                                            <TextBlock Grid.Column="4" Width="30"/>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Rows -->
                                                    <ItemsControl ItemsSource="{Binding ComponentLines}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="vm:BomLineViewModel">
                                                                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="0,6">
                                                                    <Grid ColumnDefinitions="3*, 1*, 1*, 1*, Auto">
                                                                        <!-- Component Autocomplete Picker -->
                                                                        <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,10,0" VerticalAlignment="Top">
                                                                            <Grid ColumnDefinitions="*, Auto">
                                                                                <TextBox Grid.Column="0" Text="{Binding ProductSearchText, Mode=TwoWay}" Watermark="Search component / raw material..." FontSize="12"/>
                                                                                <Button Grid.Column="1" Content="+ New" Command="{Binding CreateProductCommand}" Margin="4,0,0,0" FontSize="10" FontWeight="SemiBold" Background="{DynamicResource ContentBackgroundColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center" ToolTip.Tip="Create new component product on the fly"/>
                                                                            </Grid>

                                                                            <!-- Dropdown list of matched products -->
                                                                            <ListBox ItemsSource="{Binding MatchedProducts}"
                                                                                     IsVisible="{Binding IsDropdownVisible}"
                                                                                     MaxHeight="100"
                                                                                     Background="{DynamicResource CardBackgroundColor}"
                                                                                     BorderBrush="{DynamicResource BorderColor}"
                                                                                     BorderThickness="1"
                                                                                     CornerRadius="4">
                                                                                <ListBox.ItemTemplate>
                                                                                    <DataTemplate DataType="domain:Product">
                                                                                        <Grid ColumnDefinitions="*, Auto" Margin="2">
                                                                                            <Button Grid.Column="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="4,2"
                                                                                                    Command="{Binding $parent[ListBox].((vm:BomLineViewModel)DataContext).SelectProductCommand}" CommandParameter="{Binding .}">
                                                                                                <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                                                            </Button>
                                                                                            <Button Grid.Column="1" Content="Select" Command="{Binding $parent[ListBox].((vm:BomLineViewModel)DataContext).SelectProductCommand}" CommandParameter="{Binding .}" FontSize="9" Padding="6,2" CornerRadius="3"/>
                                                                                        </Grid>
                                                                                    </DataTemplate>
                                                                                </ListBox.ItemTemplate>
                                                                            </ListBox>

                                                                            <!-- Selected Product Indicator -->
                                                                            <Border Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1" CornerRadius="3" Padding="6,2" IsVisible="{Binding SelectedProduct, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                                                <Grid ColumnDefinitions="*, Auto">
                                                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                                        <TextBlock Text="✓" Foreground="#2E7D32" FontWeight="Bold" FontSize="10"/>
                                                                                        <TextBlock Text="{Binding SelectedProduct.Name, FallbackValue=''}" FontSize="11" FontWeight="SemiBold" Foreground="#1B5E20"/>
                                                                                    </StackPanel>
                                                                                    <Button Grid.Column="1" Content="✕" Command="{Binding ClearProductCommand}" Background="Transparent" BorderThickness="0" Foreground="#2E7D32" FontSize="10" Padding="2,0" Cursor="Hand" ToolTip.Tip="Clear selection"/>
                                                                                </Grid>
                                                                            </Border>
                                                                        </StackPanel>

                                                                        <!-- Quantity -->
                                                                        <TextBox Grid.Column="1" Text="{Binding Quantity}" Margin="10,0" VerticalAlignment="Top"/>

                                                                        <!-- Scrap -->
                                                                        <TextBox Grid.Column="2" Text="{Binding ScrapPercent}" Margin="10,0" VerticalAlignment="Top"/>

                                                                        <!-- Unit -->
                                                                        <ComboBox Grid.Column="3" ItemsSource="{Binding Units}" SelectedItem="{Binding Unit}" HorizontalAlignment="Stretch" Margin="10,0" VerticalAlignment="Top"/>

                                                                        <!-- Delete -->
                                                                        <Button Grid.Column="4" Content="✕" Command="{Binding $parent[UserControl].((vm:ManufacturingViewModel)DataContext).RemoveComponentLineCommand}" CommandParameter="{Binding .}" Foreground="Red" Background="Transparent" FontSize="12" Padding="6,2" VerticalAlignment="Top"/>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </TabItem>
                                    <TabItem Header="Operations">
                                        <Border Padding="0,20">
                                            <TextBlock Text="No operations configured for this Bill of Materials." Foreground="Gray" HorizontalAlignment="Center"/>
                                        </Border>
                                    </TabItem>
                                    <TabItem Header="Miscellaneous">
                                        <Border Padding="0,20">
                                            <TextBlock Text="Recipe settings and default ledger configurations." Foreground="Gray" HorizontalAlignment="Center"/>
                                        </Border>
                                    </TabItem>
                                </TabControl>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </TabItem>

        <!-- ==================== TAB 2: MANUFACTURING ORDERS ==================== -->
        <TabItem Header="Manufacturing Orders (MO)">
            <Grid Margin="10">
                <!-- STATE 1: MO LIST VIEW -->
                <Grid RowDefinitions="Auto,Auto,*" IsVisible="{Binding !IsMOFormVisible}">
                    <!-- Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,16">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Manufacturing Orders" FontSize="20" FontWeight="Bold" />
                            <TextBlock Text="Create production jobs and track expected vs. actual yield." FontSize="11" Foreground="Gray" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="+ New MO" Command="{Binding ShowCreateMOFormCommand}" Background="{DynamicResource NavActiveBgColor}" Foreground="{DynamicResource NavActiveTextColor}" Padding="14,6" FontWeight="SemiBold" CornerRadius="6" />
                    </Grid>

                    <!-- Search Bar -->
                    <Border Grid.Row="1" Background="{DynamicResource CardBackgroundColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,12">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBox Grid.Column="0" Text="{Binding SearchMOText}" Watermark="Search MOs by number, product, status or company..." VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" Padding="5,0"/>
                            <TextBlock Grid.Column="1" Text="🔍" VerticalAlignment="Center" Margin="5,0" Foreground="Gray"/>
                        </Grid>
                    </Border>

                    <!-- MO Grid List -->
                    <Border Grid.Row="2" Background="{DynamicResource CardBackgroundColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="12">
                        <DataGrid ItemsSource="{Binding ManufacturingOrders}" SelectedItem="{Binding SelectedMO}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="MO Number" Binding="{Binding MONumber}" Width="*" />
                                <DataGridTextColumn Header="Final Product" Binding="{Binding ProductName}" Width="2*" />
                                <DataGridTextColumn Header="Planned Qty" Binding="{Binding TargetQuantityDisplay}" Width="*" />
                                <DataGridTextColumn Header="Produced Qty" Binding="{Binding ActualQuantityDisplay}" Width="*" />
                                <DataGridTextColumn Header="Date" Binding="{Binding OrderDateDisplay}" Width="*" />
                                <DataGridTextColumn Header="Cost (RWF)" Binding="{Binding TotalCostDisplay}" Width="*" />
                                <DataGridTextColumn Header="Destination Location" Binding="{Binding DestinationLocationName}" Width="*" />
                                <DataGridTextColumn Header="Source Location" Binding="{Binding SourceLocationName}" Width="*" />
                                
                                 <!-- Status Column with Badges -->
                                <DataGridTemplateColumn Header="Status" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="6,3" HorizontalAlignment="Center" Tag="{Binding Status}">
                                                <Border.Styles>
                                                    <Style Selector="Border[Tag=Draft]">
                                                        <Setter Property="Background" Value="#9E9E9E"/>
                                                    </Style>
                                                    <Style Selector="Border[Tag=Confirmed]">
                                                        <Setter Property="Background" Value="#F57C00"/>
                                                    </Style>
                                                    <Style Selector="Border[Tag=Done]">
                                                        <Setter Property="Background" Value="#10B981"/>
                                                    </Style>
                                                </Border.Styles>
                                                <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Actions" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                <Button Content="Open" Command="{Binding $parent[UserControl].((vm:ManufacturingViewModel)DataContext).OpenMODetailCommand}" CommandParameter="{Binding}"
                                                        Background="{DynamicResource ContentBackgroundColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" FontSize="11" FontWeight="SemiBold" Padding="8,3" CornerRadius="4"/>
                                                <Button Content="Delete" Command="{Binding $parent[UserControl].((vm:ManufacturingViewModel)DataContext).DeleteMOCommand}" CommandParameter="{Binding}"
                                                        Background="#14EF4444" Foreground="#EF4444" BorderBrush="#33EF4444" BorderThickness="1" FontSize="11" FontWeight="SemiBold" Padding="8,3" CornerRadius="4"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <!-- STATE 2: FULL-SCREEN MO SHEET EDITOR VIEW -->
                <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsMOFormVisible}">
                    <!-- Form Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,16">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                            <Button Content="← Back to Orders" Command="{Binding CloseMOFormCommand}" Background="Transparent" Foreground="{DynamicResource NavActiveBgColor}" Padding="0" VerticalAlignment="Center" FontSize="13"/>
                            <TextBlock Text="/" Foreground="Gray" VerticalAlignment="Center" FontSize="13"/>
                            <TextBlock Text="{Binding MONumber, FallbackValue='New MO'}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Actions based on state -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                            <!-- Draft mode actions -->
                            <Button Content="Save Draft" Command="{Binding SaveMODraftCommand}" IsVisible="{Binding IsDraftState}" Padding="14,6" FontSize="13" CornerRadius="6"/>
                            <Button Content="Confirm" Command="{Binding ConfirmMOCommand}" IsVisible="{Binding IsDraftState}" Background="{DynamicResource NavActiveBgColor}" Foreground="{DynamicResource NavActiveTextColor}" Padding="14,6" FontSize="13" FontWeight="SemiBold" CornerRadius="6"/>

                            <!-- Confirmed mode actions -->
                            <Button Content="Produce All" Command="{Binding StartProductionInputCommand}" IsVisible="{Binding IsConfirmedState}" Background="{DynamicResource NavActiveBgColor}" Foreground="{DynamicResource NavActiveTextColor}" Padding="16,6" FontSize="13" FontWeight="SemiBold" CornerRadius="6"/>

                            <!-- Produce input active actions -->
                            <Button Content="Cancel Produce" Command="{Binding CloseMOFormCommand}" IsVisible="{Binding IsProduceStateActive}" Padding="14,6" FontSize="13" CornerRadius="6"/>
                            <Button Content="Mark as Done" Command="{Binding RecordProductionCommand}" IsVisible="{Binding IsProduceStateActive}" Background="#1410B981" Foreground="#10B981" BorderBrush="#3310B981" BorderThickness="1" Padding="16,6" FontSize="13" FontWeight="SemiBold" CornerRadius="6"/>

                            <!-- Closed/Done mode actions -->
                            <Button Content="Close Details" Command="{Binding CloseMOFormCommand}" IsVisible="{Binding IsDoneState}" Padding="14,6" FontSize="13" CornerRadius="6"/>
                        </StackPanel>
                    </Grid>

                    <!-- Sheet Details Card -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Border Background="{DynamicResource CardBackgroundColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="16">
                                <!-- Error Alerts -->
                                <Border Background="#FFEBEE" BorderBrush="#FFCDD2" BorderThickness="1" CornerRadius="4" Padding="10" IsVisible="{Binding HasError}">
                                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#B71C1C" FontSize="12" TextWrapping="Wrap"/>
                                </Border>

                                <!-- Header Fields -->
                                <Grid ColumnDefinitions="*, *" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,0,0,10">
                                    <!-- Left side fields -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="5" Margin="0,0,16,12">
                                        <TextBlock Text="Bill of Materials Recipe" FontSize="11" FontWeight="SemiBold" Foreground="Gray"/>
                                        <!-- Editable only in Draft -->
                                        <ComboBox ItemsSource="{Binding ActiveBoms}" SelectedItem="{Binding SelectedBoMForMO}" 
                                                  IsEnabled="{Binding IsDraftState}"
                                                  HorizontalAlignment="Stretch" PlaceholderText="Select recipe (BoM)...">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding ProductName, StringFormat='{}{0}'}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="5" Margin="0,0,16,12">
                                        <TextBlock Text="Finished Product" FontSize="11" FontWeight="SemiBold" Foreground="Gray"/>
                                        <TextBox Text="{Binding MOProduct.Name, FallbackValue='No Product Selected'}" IsEnabled="False" Foreground="Gray"/>
                                    </StackPanel>

                                    <!-- Target Qty / Produce Qty -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Spacing="5" Margin="0,0,16,12">
                                        <!-- Draft/Confirmed target qty edit -->
                                        <TextBlock Text="Target Quantity to Produce" FontSize="11" FontWeight="SemiBold" Foreground="Gray" 
                                                   IsVisible="{Binding !IsProduceStateActive}"/>
                                        <TextBox Text="{Binding MOTargetQuantity}" Watermark="1.0" 
                                                 IsEnabled="{Binding IsDraftState}"
                                                 IsVisible="{Binding !IsProduceStateActive}"/>
                                        
                                        <!-- Yield Actual edit visible only during Produce -->
                                        <TextBlock Text="ACTUAL PRODUCED QUANTITY (YIELD)" FontSize="11" FontWeight="Bold" Foreground="#2E7D32" 
                                                   IsVisible="{Binding IsProduceStateActive}"/>
                                        <TextBox Text="{Binding MOActualQuantity}" Watermark="Enter yield..." Background="#E8F5E9"
                                                 IsVisible="{Binding IsProduceStateActive}"/>

                                        <!-- Done state actual qty display -->
                                        <TextBlock Text="Actual Produced Quantity (Done)" FontSize="11" FontWeight="SemiBold" Foreground="Gray" 
                                                   IsVisible="{Binding IsDoneState}"/>
                                        <TextBox Text="{Binding MOActualQuantity}" IsEnabled="False" 
                                                 IsVisible="{Binding IsDoneState}"/>
                                    </StackPanel>

                                    <!-- Finished Goods Location -->
                                    <StackPanel Grid.Row="3" Grid.Column="0" Spacing="5" Margin="0,0,16,12">
                                        <TextBlock Text="Finished Goods Location" FontSize="11" FontWeight="SemiBold" Foreground="Gray"/>
                                        <Grid ColumnDefinitions="*, Auto">
                                            <ComboBox Grid.Column="0" ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedMODestinationLocation}" 
                                                      IsEnabled="{Binding IsDraftState}"
                                                      HorizontalAlignment="Stretch" PlaceholderText="Select destination location...">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button Grid.Column="1" Content="Clear" Command="{Binding ClearMODestinationLocationCommand}" 
                                                    IsEnabled="{Binding IsDraftState}" Margin="6,0,0,0" Padding="8,4" FontSize="11"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Right side fields -->
                                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="5" Margin="16,0,0,12">
                                        <TextBlock Text="MO Number" FontSize="11" FontWeight="SemiBold" Foreground="Gray"/>
                                        <TextBox Text="{Binding MONumber}" IsEnabled="False" Foreground="Gray"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="5" Margin="16,0,0,12">
                                        <TextBlock Text="Status" FontSize="11" FontWeight="SemiBold" Foreground="Gray"/>
                                        <Border CornerRadius="4" Padding="8,4" Tag="{Binding MOStatus}" HorizontalAlignment="Left">
                                            <Border.Styles>
                                                <Style Selector="Border[Tag=Draft]">
                                                    <Setter Property="Background" Value="#9E9E9E"/>
                                                </Style>
                                                <Style Selector="Border[Tag=Confirmed]">
                                                    <Setter Property="Background" Value="#F57C00"/>
                                                </Style>
                                                <Style Selector="Border[Tag=Done]">
                                                    <Setter Property="Background" Value="#2E7D32"/>
                                                </Style>
                                            </Border.Styles>
                                            <TextBlock Text="{Binding MOStatus}" FontSize="12" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="1" Spacing="5" Margin="16,0,0,12">
                                        <TextBlock Text="Company" FontSize="11" FontWeight="SemiBold" Foreground="Gray"/>
                                        <TextBox Text="{Binding MOCompany}" Watermark="Company settings"
                                                 IsEnabled="{Binding IsDraftState}"/>
                                    </StackPanel>

                                    <!-- Components Source Location -->
                                    <StackPanel Grid.Row="3" Grid.Column="1" Spacing="5" Margin="16,0,0,12">
                                        <TextBlock Text="Components Source Location" FontSize="11" FontWeight="SemiBold" Foreground="Gray"/>
                                        <Grid ColumnDefinitions="*, Auto">
                                            <ComboBox Grid.Column="0" ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedMOSourceLocation}" 
                                                      IsEnabled="{Binding IsDraftState}"
                                                      HorizontalAlignment="Stretch" PlaceholderText="Select source location...">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button Grid.Column="1" Content="Clear" Command="{Binding ClearMOSourceLocationCommand}" 
                                                    IsEnabled="{Binding IsDraftState}" Margin="6,0,0,0" Padding="8,4" FontSize="11"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <!-- TabControl Ingredients -->
                                <TabControl Margin="0,10,0,0">
                                    <TabItem Header="Components">
                                        <Border BorderThickness="0" Padding="0,12,0,0">
                                            <StackPanel Spacing="6">
                                                <!-- Headers -->
                                                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="0,4,0,8">
                                                    <Grid ColumnDefinitions="3*, 1*, 1*, 1*, Auto">
                                                        <TextBlock Grid.Column="0" Text="Component" FontWeight="SemiBold" FontSize="12" Foreground="Gray"/>
                                                        <TextBlock Grid.Column="1" Text="To Consume (Planned)" FontWeight="SemiBold" FontSize="12" Foreground="Gray" Margin="6,0"/>
                                                        <TextBlock Grid.Column="2" Text="Consumed (Actual)" FontWeight="SemiBold" FontSize="12" Foreground="Gray" Margin="6,0"/>
                                                        <TextBlock Grid.Column="3" Text="Unit" FontWeight="SemiBold" FontSize="12" Foreground="Gray" Margin="6,0"/>
                                                        <TextBlock Grid.Column="4" Text="Unit Cost" FontWeight="SemiBold" FontSize="12" Foreground="Gray" Width="60" TextAlignment="Right"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Component Rows -->
                                                <ItemsControl ItemsSource="{Binding MOComponentLines}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="0,8">
                                                                <Grid ColumnDefinitions="3*, 1*, 1*, 1*, Auto" VerticalAlignment="Center">
                                                                    <TextBlock Grid.Column="0" Text="{Binding ProductName}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding ExpectedQuantity, StringFormat='{}{0:F2}'}" Margin="6,0" VerticalAlignment="Center"/>
                                                                    
                                                                    <!-- Actual Consumed: editable only during ProduceStateActive -->
                                                                    <TextBox Grid.Column="2" Text="{Binding ActualQuantity}" Margin="6,0" VerticalAlignment="Center"
                                                                             IsEnabled="{Binding $parent[UserControl].((vm:ManufacturingViewModel)DataContext).IsProduceStateActive}"/>
                                                                    
                                                                    <TextBlock Grid.Column="3" Text="{Binding Unit}" Margin="6,0" VerticalAlignment="Center" Foreground="Gray"/>
                                                                    <TextBlock Grid.Column="4" Text="{Binding UnitCost, StringFormat='{}{0:N2}'}" VerticalAlignment="Center" TextAlignment="Right" Width="60" Foreground="Gray"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </TabItem>
                                    <TabItem Header="Miscellaneous">
                                        <Border Padding="0,20">
                                            <TextBlock Text="Manufacturing Order logs, audit fields and system users." Foreground="Gray" HorizontalAlignment="Center"/>
                                        </Border>
                                    </TabItem>
                                </TabControl>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </TabItem>

        <!-- ==================== TAB 3: PRODUCTION REPORTING ==================== -->
        <TabItem Header="Reporting">
            <Grid RowDefinitions="Auto, *" Margin="10">
                <!-- Summary Widgets Card Grid -->
                <Grid Grid.Row="0" ColumnDefinitions="*, *, *" Margin="0,0,0,20">
                    <!-- Widget 1: Total Manufacturing Orders -->
                    <Border Grid.Column="0" Background="{DynamicResource CardBackgroundColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,10,0">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Total Runs Started" FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalMOsCount}" FontSize="24" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- Widget 2: Completed Orders -->
                    <Border Grid.Column="1" Background="{DynamicResource CardBackgroundColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="10,0,10,0">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Completed Production Runs" FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CompletedMOsCount}" FontSize="24" FontWeight="Bold" Foreground="#2E7D32"/>
                        </StackPanel>
                    </Border>

                    <!-- Widget 3: Cumulative Cost of Materials -->
                    <Border Grid.Column="2" Background="{DynamicResource CardBackgroundColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="10,0,0,0">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Cumulative Materials Cost" FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalProductionCost, StringFormat='{}{0:N2} RWF'}" FontSize="22" FontWeight="Bold" Foreground="#007ACC"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- DataGrid logs list -->
                <Border Grid.Row="1" Background="{DynamicResource CardBackgroundColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Finished Goods Yields &amp; Cost Summaries" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <DataGrid ItemsSource="{Binding ReportOrders}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Production Code (MO)" Binding="{Binding MONumber}" Width="*" />
                                <DataGridTextColumn Header="Final Manufactured Good" Binding="{Binding ProductName}" Width="2*" />
                                <DataGridTextColumn Header="Planned Qty" Binding="{Binding ManufacturingOrder.TargetQuantity}" Width="*" />
                                <DataGridTextColumn Header="Actual Qty Produced" Binding="{Binding ManufacturingOrder.ActualQuantity}" Width="*" />
                                <DataGridTextColumn Header="Yield Cost (RWF)" Binding="{Binding TotalCostDisplay}" Width="*" />
                                <DataGridTextColumn Header="Date Completed" Binding="{Binding ManufacturingOrder.ProduceDate, StringFormat='{}{0:yyyy-MM-dd}'}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </TabItem>
    </TabControl>

    <!-- Sub-creation overlay: Create Product on the Fly (Layer 3) -->
    <Grid Background="#7F000000" IsVisible="{Binding IsCreateProductModalOpen}" ZIndex="30" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Border Background="{DynamicResource ContentBackgroundColor}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                CornerRadius="8"
                Width="440"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                BoxShadow="0 8 32 0 #40000000"
                Padding="20">
            <StackPanel Spacing="15">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Text="Create Product on the Fly" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="✕" Command="{Binding CancelCreateProductCommand}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondaryColor}" Padding="6,2" Cursor="Hand"/>
                </Grid>

                <StackPanel Spacing="5">
                    <TextBlock Text="Product Name *" FontSize="12" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding NewProductName}"/>
                </StackPanel>

                <Grid ColumnDefinitions="*, 15, *">
                    <StackPanel Grid.Column="0" Spacing="5">
                        <TextBlock Text="Cost Price" FontSize="12" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding NewProductCost}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="5">
                        <TextBlock Text="Sales Price" FontSize="12"/>
                        <TextBox Text="{Binding NewProductPrice}"/>
                    </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="*, 15, *">
                    <StackPanel Grid.Column="0" Spacing="5">
                        <TextBlock Text="Unit" FontSize="12" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding NewProductUnit}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="5">
                        <TextBlock Text="Category" FontSize="12"/>
                        <TextBox Text="{Binding NewProductCategory}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding NewProductErrorMessage}" Foreground="#EF4444" TextWrapping="Wrap" IsVisible="{Binding NewProductErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="Cancel" Command="{Binding CancelCreateProductCommand}" Padding="14,6" CornerRadius="6"/>
                    <Button Content="Save Product" Command="{Binding SaveNewProductCommand}" Background="{DynamicResource NavActiveBgColor}" Foreground="{DynamicResource NavActiveTextColor}" Padding="14,6" FontWeight="SemiBold" CornerRadius="6"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Grid>
</UserControl>
