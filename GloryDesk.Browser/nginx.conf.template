server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    types {
        application/wasm wasm;
    }

    gzip on;
    gzip_types application/wasm application/javascript application/octet-stream text/javascript application/json;
    gzip_min_length 1024;

    location / {
        try_files $uri $uri/ /index.html;
    }
}
