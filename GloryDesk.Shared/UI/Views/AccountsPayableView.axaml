<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:InventoryManagementSystem.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="760"
             x:Class="InventoryManagementSystem.UI.Views.AccountsPayableView"
             x:DataType="vm:AccountsPayableViewModel">

    <Grid RowDefinitions="Auto,*" ColumnDefinitions="330,*" Margin="20">

        <!-- Header + KPIs -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Spacing="2">
                <TextBlock Text="Accounts Payable" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="Suppliers you owe — open vendor bills and the linked purchase order" FontSize="13" Foreground="Gray" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                    <StackPanel>
                        <TextBlock Text="Total Payable" FontSize="11" Foreground="Gray" />
                        <TextBlock Text="{Binding TotalPayable, StringFormat='{}{0:N0}'}" FontWeight="Bold" FontSize="16" />
                    </StackPanel>
                </Border>
                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                    <StackPanel>
                        <TextBlock Text="Overdue" FontSize="11" Foreground="Gray" />
                        <TextBlock Text="{Binding TotalOverdue, StringFormat='{}{0:N0}'}" FontWeight="Bold" FontSize="16" />
                    </StackPanel>
                </Border>
                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                    <StackPanel>
                        <TextBlock Text="Open Bills" FontSize="11" Foreground="Gray" />
                        <TextBlock Text="{Binding OpenBillCount}" FontWeight="Bold" FontSize="16" />
                    </StackPanel>
                </Border>
                <Button Content="Refresh" Command="{Binding LoadCommand}" Padding="12,6" CornerRadius="6" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Left: suppliers we owe -->
        <Border Grid.Row="1" Grid.Column="0" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Margin="0,0,14,0">
            <Grid RowDefinitions="Auto,*">
                <TextBox Grid.Row="0" Watermark="Search supplier..." Text="{Binding SearchText}" Margin="10" />
                <ListBox Grid.Row="1" ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ApSupplierRow">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="4,6">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding SupplierName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OpenBalance, StringFormat='{}{0:N0}'}" FontWeight="SemiBold" />
                                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding BillCount, StringFormat='{}{0} bill(s)'}" FontSize="11" Foreground="Gray" />
                                    <TextBlock Text="{Binding OldestDueDate, StringFormat='due {0:yyyy-MM-dd}'}" FontSize="11" Foreground="Gray" />
                                </StackPanel>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OverdueAmount, StringFormat='{}{0:N0} overdue'}" FontSize="11" Foreground="Gray" IsVisible="{Binding HasOverdue}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Right: bills + selected bill detail -->
        <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,*,Auto">

            <TextBlock Grid.Row="0" Text="{Binding SelectedSupplier.SupplierName, StringFormat='Open bills — {0}'}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" />

            <DataGrid Grid.Row="1" ItemsSource="{Binding Bills}" SelectedItem="{Binding SelectedBill}" AutoGenerateColumns="False" IsReadOnly="True"
                      GridLinesVisibility="Horizontal" MinHeight="140" MaxHeight="240">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Bill / PO" Binding="{Binding PoNumber}" Width="140" />
                    <DataGridTextColumn Header="Order Date" Binding="{Binding OrderDate, StringFormat={}{0:yyyy-MM-dd}}" Width="110" />
                    <DataGridTextColumn Header="Due Date" Binding="{Binding DueDate, StringFormat={}{0:yyyy-MM-dd}}" Width="110" />
                    <DataGridTextColumn Header="Days Overdue" Binding="{Binding DaysOverdue}" Width="110" />
                    <DataGridTextColumn Header="Bill Total" Binding="{Binding RecordedTotal, StringFormat='{}{0:N2}'}" Width="120" />
                    <DataGridTextColumn Header="Open Balance" Binding="{Binding OpenBalance, StringFormat='{}{0:N2}'}" Width="130" />
                    <DataGridTemplateColumn Header="PO" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:ApBillRow">
                                <Button Content="View PO" FontSize="11" FontWeight="SemiBold" Padding="8,3" CornerRadius="4"
                                        Background="{DynamicResource ContentBackgroundColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                        Command="{Binding $parent[UserControl].((vm:AccountsPayableViewModel)DataContext).ViewPurchaseOrderCommand}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Selected bill detail -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,12,0,0"
                    IsVisible="{Binding SelectedBill, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding SelectedBill.PoNumber, StringFormat='Bill {0}'}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Pay Bill" Command="{Binding OpenPayBillCommand}" IsEnabled="{Binding CanPaySelectedBill}"
                                Background="{DynamicResource NavActiveBgColor}" Foreground="{DynamicResource NavActiveTextColor}" FontWeight="SemiBold" Padding="14,6" CornerRadius="6" />
                    </Grid>

                    <DataGrid ItemsSource="{Binding BillLines}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" MaxHeight="220">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*" />
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="70" />
                            <DataGridTextColumn Header="Unit Cost" Binding="{Binding UnitCost, StringFormat='{}{0:N2}'}" Width="110" />
                            <DataGridTextColumn Header="Tax" Binding="{Binding TaxLabel}" Width="150" />
                            <DataGridTextColumn Header="Tax Amt" Binding="{Binding TaxAmount, StringFormat='{}{0:N2}'}" Width="100" />
                            <DataGridTextColumn Header="Line Total" Binding="{Binding LineTotal, StringFormat='{}{0:N2}'}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Subtotal (untaxed)" Foreground="Gray" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding BillSubtotal, StringFormat='{}{0:N2}'}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Line tax" Foreground="Gray" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BillTaxTotal, StringFormat='{}{0:N2}'}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Recorded bill total" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BillRecordedTotal, StringFormat='{}{0:N2}'}" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Paid so far" Foreground="Gray" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding BillPaid, StringFormat='{}{0:N2}'}" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Open balance" FontWeight="Bold" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding BillOpenBalance, StringFormat='{}{0:N2}'}" FontWeight="Bold" />
                    </Grid>

                    <TextBlock Text="{Binding BillTaxNote}" FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                               IsVisible="{Binding BillTaxNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="Gray"
                               IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Payment modal -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="2" Background="#80000000" IsVisible="{Binding IsPaymentModalOpen}">
            <Border Background="{DynamicResource ContentBackgroundColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                    CornerRadius="8" Padding="20" Width="380" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 10 30 0 #40000000">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding SelectedBill.PoNumber, StringFormat='Pay {0}'}" FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="{Binding BillOpenBalance, StringFormat='Open balance: {0:N2}'}" FontSize="12" Foreground="Gray" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Command="{Binding CancelPaymentCommand}"
                                Background="Transparent" BorderThickness="0" FontSize="14" FontWeight="Bold" Padding="6,2" VerticalAlignment="Top" />
                    </Grid>

                    <TextBlock Text="Amount" FontSize="11" Foreground="Gray" />
                    <TextBox Text="{Binding PaymentAmount}" />

                    <TextBlock Text="Method" FontSize="11" Foreground="Gray" />
                    <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PaymentMethod}" HorizontalAlignment="Stretch" />

                    <TextBlock Text="Reference (optional)" FontSize="11" Foreground="Gray" />
                    <TextBox Text="{Binding PaymentReference}" />

                    <TextBlock Text="{Binding PaymentError}" Foreground="#EF4444" FontSize="12" TextWrapping="Wrap"
                               IsVisible="{Binding PaymentError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CancelPaymentCommand}" Padding="14,6" CornerRadius="6" />
                        <Button Content="Confirm Payment" Command="{Binding SubmitPaymentCommand}"
                                Background="{DynamicResource NavActiveBgColor}" Foreground="{DynamicResource NavActiveTextColor}" FontWeight="SemiBold" Padding="14,6" CornerRadius="6" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
