<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:InventoryManagementSystem.UI.ViewModels"
             xmlns:helpers="using:InventoryManagementSystem.UI.Helpers"
             xmlns:views="clr-namespace:InventoryManagementSystem.UI.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="InventoryManagementSystem.UI.Views.InventoryView"
             x:DataType="vm:InventoryViewModel"
             x:Name="Root">
    
    <Grid>
        <!-- Main Product List / Grid Content Layer -->
        <Grid RowDefinitions="Auto, Auto, *" Margin="15">
            <!-- Quick Actions Toolbar -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Quick Actions:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextSecondaryColor}"/>
                    <Button Content="Buying ▾" Background="#14007ACC" Foreground="#007ACC" BorderBrush="#33007ACC" BorderThickness="1" Padding="12,6" FontWeight="SemiBold" CornerRadius="6">
                        <Button.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuItem Header="Ask Supplier for Price" Command="{Binding GoToRfqScreenCommand}"/>
                                <MenuItem Header="Orders to Suppliers" Command="{Binding GoToPurchaseOrdersScreenCommand}"/>
                                <MenuItem Header="Suppliers" Command="{Binding GoToSuppliersScreenCommand}"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button Content="Selling ▾" Background="#1410B981" Foreground="#10B981" BorderBrush="#3310B981" BorderThickness="1" Padding="12,6" FontWeight="SemiBold" CornerRadius="6">
                        <Button.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuItem Header="Price Quotes" Command="{Binding GoToSalesQuotationsScreenCommand}"/>
                                <MenuItem Header="Customer Orders" Command="{Binding GoToSalesOrdersScreenCommand}"/>
                                <MenuItem Header="Customers" Command="{Binding GoToCustomersScreenCommand}"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button Content="Stock Tools ▾" Background="#148B5CF6" Foreground="#8B5CF6" BorderBrush="#338B5CF6" BorderThickness="1" Padding="12,6" FontWeight="SemiBold" CornerRadius="6">
                        <Button.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuItem Header="Stock Transfer" Command="{Binding GoToStockTransferScreenCommand}"/>
                                <MenuItem Header="Stock Counts" Command="{Binding GoToCycleCountScreenCommand}"/>
                                <MenuItem Header="What to Reorder" Command="{Binding GoToReorderDashboardScreenCommand}"/>
                                <MenuItem Header="Demand Forecast" Command="{Binding GoToForecastingScreenCommand}"/>
                                <MenuItem Header="Store Locations" Command="{Binding GoToLocationsScreenCommand}"/>
                                <MenuItem Header="Damage / Loss Write-off" Command="{Binding GoToDamageWriteOffScreenCommand}"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button Content="Reporting ▾" Background="#1406B6D4" Foreground="#06B6D4" BorderBrush="#3306B6D4" BorderThickness="1" Padding="12,6" FontWeight="SemiBold" CornerRadius="6">
                        <Button.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuItem Header="Stock" Command="{Binding GoToStockReportScreenCommand}"/>
                                <MenuItem Header="Moves History" Command="{Binding GoToMovesHistoryScreenCommand}"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Header / Toolbar -->
            <Grid Grid.Row="1" ColumnDefinitions="*, Auto, Auto" Margin="0,0,0,15">
                <StackPanel Spacing="4">
                    <TextBox x:Name="InventorySearchBox" Text="{Binding SearchText}" Watermark="Scan barcode or search products..." Width="320" HorizontalAlignment="Left" KeyDown="OnSearchKeyDown" CornerRadius="6"/>
                    <TextBlock Text="{Binding BarcodeStatusMessage}" FontSize="11" Foreground="#059669" IsVisible="{Binding BarcodeStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>
                
                <Button Grid.Column="1" Margin="0,0,10,0" 
                        Content="{Binding Language.Resources[Inv_Import]}" 
                        Command="{Binding ImportProductsCommand}" 
                        IsEnabled="{Binding CanBulkImport}"
                        ToolTip.Tip="{Binding BulkImportTooltip}"
                        Background="{DynamicResource ContentBackgroundColor}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,6"
                        FontWeight="SemiBold"/>
                        
                <Button Grid.Column="2" Content="{Binding Language.Resources[Inv_NewProduct]}" Command="{Binding OpenAddProductPaneCommand}"
                        Background="{DynamicResource NavActiveBgColor}" Foreground="{DynamicResource NavActiveTextColor}"
                        CornerRadius="6" Padding="14,6" FontWeight="SemiBold"/>
            </Grid>

            <!-- Product List -->
            <DataGrid Grid.Row="2" ItemsSource="{Binding Products}" 
                      SelectedItem="{Binding SelectedProduct}"
                      AutoGenerateColumns="False" 
                      IsReadOnly="True" 
                      CanUserSortColumns="True"
                      GridLinesVisibility="All"
                      BorderThickness="1" BorderBrush="{DynamicResource BorderColor}" Background="{DynamicResource ContentBackgroundColor}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{Binding Language.Resources[Inv_SKU]}" Binding="{Binding SKU}" Width="100"/>
                    <DataGridTextColumn Header="{Binding Language.Resources[Inv_ProductName]}" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="{Binding Language.Resources[Inv_Category]}" Binding="{Binding Category}" Width="120"/>
                    <DataGridTemplateColumn Header="{Binding Language.Resources[Inv_Stock]}" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8,2" CornerRadius="10" Background="{DynamicResource NavHoverColor}">
                                    <TextBlock Text="{Binding StockQuantity}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryColor}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{Binding Language.Resources[Inv_Unit]}" Binding="{Binding Unit}" Width="70"/>
                    <DataGridTemplateColumn Header="{Binding Language.Resources[Inv_SellingPrice]}" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center" Margin="5,0,0,0" FontWeight="SemiBold">
                                    <Run Text="{Binding Price, StringFormat='{}{0:N0}'}"/>
                                    <Run Text="{Binding #Root.DataContext.CurrencySymbol}" FontSize="11" Foreground="{DynamicResource TextSecondaryColor}"/>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    
                    <DataGridTemplateColumn Header="{Binding Language.Resources[Inv_Actions]}" Width="270">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                    <Button Content="History" Command="{Binding $parent[UserControl].((vm:InventoryViewModel)DataContext).OpenProductHistoryCommand}" CommandParameter="{Binding .}"
                                            Background="#143B82F6" Foreground="#3B82F6" BorderBrush="#333B82F6" BorderThickness="1" FontSize="11" FontWeight="SemiBold" Padding="8,3" CornerRadius="4"/>
                                    <Button Content="Stock" Command="{Binding $parent[UserControl].((vm:InventoryViewModel)DataContext).OpenStockPaneCommand}" CommandParameter="{Binding .}"
                                            Background="#14F59E0B" Foreground="#F59E0B" BorderBrush="#33F59E0B" BorderThickness="1" FontSize="11" FontWeight="SemiBold" Padding="8,3" CornerRadius="4"/>
                                    <Button Content="Edit" Command="{Binding $parent[UserControl].((vm:InventoryViewModel)DataContext).OpenEditProductPaneCommand}" CommandParameter="{Binding .}"
                                            Background="{DynamicResource ContentBackgroundColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" FontSize="11" FontWeight="SemiBold" Padding="8,3" CornerRadius="4"/>
                                    <Button Content="Delete" Command="{Binding $parent[UserControl].((vm:InventoryViewModel)DataContext).DeleteProductCommand}" CommandParameter="{Binding .}"
                                            Background="#14EF4444" Foreground="#EF4444" BorderBrush="#33EF4444" BorderThickness="1" FontSize="11" FontWeight="SemiBold" Padding="8,3" CornerRadius="4"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Main Modal Overlay for Add/Edit/Stock (Layer 1) -->
        <Grid Background="#7F000000" IsVisible="{Binding IsPaneOpen}" ZIndex="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="{DynamicResource ContentBackgroundColor}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="8"
                    MaxWidth="900"
                    MinWidth="400"
                    MinHeight="350"
                    Width="600"
                    Height="580"
                    Padding="25"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    BoxShadow="0 8 32 0 #40000000"
                    helpers:ResizableHelper.CanResize="True">
                <Grid RowDefinitions="Auto, *, Auto">
                    <!-- Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,15">
                        <TextBlock Text="{Binding PaneTitle}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryColor}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Command="{Binding CancelPaneCommand}"
                                Content="✕" FontSize="16" Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource TextSecondaryColor}" Padding="6,2" Cursor="Hand"/>
                    </Grid>
                    
                    <!-- Scrollable Body -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="15">
                            
                            <!-- 1. Product Add/Edit Form -->
                             <TabControl IsVisible="{Binding !IsStockMode}" Margin="0,5,0,0">
                                 <TabItem Header="General Information">
                                     <StackPanel Spacing="15" Margin="0,10,0,0">
                                         <!-- Product Name -->
                                         <StackPanel Spacing="5">
                                             <TextBlock Text="Product Name" FontSize="12" FontWeight="SemiBold"/>
                                             <TextBox Watermark="e.g. Premium Wireless Mouse" Text="{Binding CurrentProduct.Name}" />
                                         </StackPanel>

                                         <!-- SKU -->
                                         <StackPanel Spacing="5">
                                             <TextBlock Text="SKU (internal code)" FontSize="12" FontWeight="SemiBold"/>
                                             <TextBox Watermark="e.g. SKU12345" Text="{Binding CurrentProduct.SKU}" />
                                         </StackPanel>

                                         <!-- Barcode -->
                                         <StackPanel Spacing="5">
                                             <TextBlock Text="Barcode (UPC/EAN, for scanning)" FontSize="12" FontWeight="SemiBold"/>
                                             <TextBox Watermark="Scan or type the barcode printed on the item" Text="{Binding CurrentProduct.Barcode}" />
                                         </StackPanel>

                                         <!-- Service Level Availability Checkboxes -->
                                         <StackPanel Spacing="5">
                                             <TextBlock Text="Services Availability" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                             <Grid ColumnDefinitions="*, *, *">
                                                 <CheckBox Grid.Column="0" Content="Sales" IsChecked="{Binding CurrentProduct.CanBeSold}"/>
                                                 <CheckBox Grid.Column="1" Content="Purchases" IsChecked="{Binding CurrentProduct.CanBePurchased}"/>
                                                 <CheckBox Grid.Column="2" Content="Point of Sale" IsChecked="{Binding CurrentProduct.AvailableInPOS}"/>
                                             </Grid>
                                         </StackPanel>

                                         <!-- Product Type & Tracking -->
                                         <Grid ColumnDefinitions="*, 15, *">
                                             <StackPanel Grid.Column="0" Spacing="5">
                                                 <TextBlock Text="Product Type" FontSize="12" FontWeight="SemiBold"/>
                                                 <ComboBox ItemsSource="{Binding ProductTypes}" SelectedItem="{Binding CurrentProduct.ProductType}" HorizontalAlignment="Stretch"/>
                                             </StackPanel>
                                             <StackPanel Grid.Column="2" Spacing="5">
                                                 <TextBlock Text="Tracking" FontSize="12" FontWeight="SemiBold"/>
                                                 <ComboBox ItemsSource="{Binding TrackingOptions}" SelectedItem="{Binding CurrentProduct.Tracking}" HorizontalAlignment="Stretch"/>
                                             </StackPanel>
                                         </Grid>

                                         <!-- Invoicing Policy & Sales Tax -->
                                         <Grid ColumnDefinitions="*, 15, *">
                                             <StackPanel Grid.Column="0" Spacing="5">
                                                 <TextBlock Text="Invoicing Policy" FontSize="12" FontWeight="SemiBold"/>
                                                 <ComboBox ItemsSource="{Binding InvoicingPolicies}" SelectedItem="{Binding CurrentProduct.InvoicingPolicy}" HorizontalAlignment="Stretch"/>
                                             </StackPanel>
                                             <StackPanel Grid.Column="2" Spacing="5">
                                                 <TextBlock Text="Sales Tax" FontSize="12" FontWeight="SemiBold"/>
                                                 <ComboBox ItemsSource="{Binding SalesTaxes}" SelectedItem="{Binding SelectedSalesTax}" DisplayMemberBinding="{Binding Name}" HorizontalAlignment="Stretch"/>
                                             </StackPanel>
                                         </Grid>

                                         <!-- Sale Price & Unit of Measure -->
                                         <Grid ColumnDefinitions="*, 15, *">
                                             <StackPanel Grid.Column="0" Spacing="5">
                                                 <TextBlock Text="Sale Price" FontSize="12" FontWeight="SemiBold"/>
                                                 <TextBox Watermark="0.00" Text="{Binding CurrentProduct.Price}" />
                                             </StackPanel>
                                             <StackPanel Grid.Column="2" Spacing="5">
                                                 <TextBlock Text="Unit of Measure" FontSize="12" FontWeight="SemiBold"/>
                                                 <ComboBox ItemsSource="{Binding UnitOptions}" SelectedItem="{Binding SelectedUnitName}" HorizontalAlignment="Stretch"/>
                                             </StackPanel>
                                         </Grid>

                                         <!-- Cost & Category -->
                                         <Grid ColumnDefinitions="*, 15, *">
                                             <StackPanel Grid.Column="0" Spacing="5">
                                                 <TextBlock Text="Cost" FontSize="12" FontWeight="SemiBold"/>
                                                 <TextBox Watermark="0.00" Text="{Binding CurrentProduct.Cost}" />
                                             </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="5">
                                                <TextBlock Text="{Binding Language.Resources[Category]}" FontSize="12" FontWeight="SemiBold"/>
                                                <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategoryName}" HorizontalAlignment="Stretch"/>
                                            </StackPanel>
                                         </Grid>

                                         <!-- Initial Stock (Only for new products) -->
                                         <StackPanel Spacing="5" IsVisible="{Binding CurrentProduct.Id, Converter={x:Static ObjectConverters.IsNull}}">
                                             <TextBlock Text="Initial Stock Quantity" FontSize="12" FontWeight="SemiBold"/>
                                             <TextBox Watermark="0" Text="{Binding CurrentProduct.StockQuantity}"/>
                                         </StackPanel>
                                     </StackPanel>
                                 </TabItem>

                                 <TabItem Header="Accounting">
                                     <StackPanel Spacing="15" Margin="0,10,0,0">
                                         <!-- Cost and Revenue Title -->
                                         <TextBlock Text="Cost and Revenue" FontSize="16" FontWeight="Bold" Margin="0,5,0,10" Foreground="#007ACC"/>

                                         <!-- Income Account Search -->
                                         <StackPanel Spacing="5">
                                             <TextBlock Text="Income Account" FontSize="12" FontWeight="SemiBold"/>
                                             <TextBox Watermark="Type to search income accounts..." Text="{Binding IncomeAccountSearchText, Mode=TwoWay}" />
                                             <TextBlock Text="{Binding SelectedIncomeAccountName}" FontSize="11" Foreground="Gray" IsVisible="{Binding SelectedIncomeAccountName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                             <!-- Matching List Dropdown -->
                                             <ListBox ItemsSource="{Binding MatchedIncomeAccounts}" Height="120" MaxHeight="150"
                                                      IsVisible="{Binding IsIncomeAccountListVisible}" Background="{DynamicResource CardBackgroundColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                                 <ListBox.ItemTemplate>
                                                     <DataTemplate>
                                                         <Grid ColumnDefinitions="*, Auto">
                                                             <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                                 <TextBlock Text="{Binding Code}" FontWeight="SemiBold"/>
                                                                 <TextBlock Text="-"/>
                                                                 <TextBlock Text="{Binding Name}"/>
                                                             </StackPanel>
                                                             <Button Grid.Column="1" Content="Select" Command="{Binding $parent[UserControl].((vm:InventoryViewModel)DataContext).SelectIncomeAccountCommand}" CommandParameter="{Binding .}" FontSize="10" Padding="5,2"/>
                                                         </Grid>
                                                     </DataTemplate>
                                                 </ListBox.ItemTemplate>
                                             </ListBox>
                                         </StackPanel>

                                         <!-- Expense Account Search -->
                                         <StackPanel Spacing="5" Margin="0,15,0,0">
                                             <TextBlock Text="Expense Account" FontSize="12" FontWeight="SemiBold"/>
                                             <TextBox Watermark="Type to search expense accounts..." Text="{Binding ExpenseAccountSearchText, Mode=TwoWay}" />
                                             <TextBlock Text="{Binding SelectedExpenseAccountName}" FontSize="11" Foreground="Gray" IsVisible="{Binding SelectedExpenseAccountName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                             <!-- Matching List Dropdown -->
                                             <ListBox ItemsSource="{Binding MatchedExpenseAccounts}" Height="120" MaxHeight="150"
                                                      IsVisible="{Binding IsExpenseAccountListVisible}" Background="{DynamicResource CardBackgroundColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                                 <ListBox.ItemTemplate>
                                                     <DataTemplate>
                                                         <Grid ColumnDefinitions="*, Auto">
                                                             <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                                 <TextBlock Text="{Binding Code}" FontWeight="SemiBold"/>
                                                                 <TextBlock Text="-"/>
                                                                 <TextBlock Text="{Binding Name}"/>
                                                             </StackPanel>
                                                             <Button Grid.Column="1" Content="Select" Command="{Binding $parent[UserControl].((vm:InventoryViewModel)DataContext).SelectExpenseAccountCommand}" CommandParameter="{Binding .}" FontSize="10" Padding="5,2"/>
                                                         </Grid>
                                                     </DataTemplate>
                                                 </ListBox.ItemTemplate>
                                             </ListBox>
                                         </StackPanel>
                                     </StackPanel>
                                 </TabItem>

                                  <TabItem Header="Inventory &amp; Locations">
                                      <StackPanel Spacing="15" Margin="0,10,0,0">
                                          <!-- Finished Goods / Storage Location -->
                                          <StackPanel Spacing="5">
                                              <TextBlock Text="Storage / Finished Goods Location" FontSize="12" FontWeight="SemiBold"/>
                                              <TextBlock Text="Default destination location where manufactured finished goods and purchased inventory are deposited." FontSize="11" Foreground="Gray"/>
                                              <Grid ColumnDefinitions="*, Auto">
                                                  <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableLocations}" SelectedItem="{Binding SelectedDefaultLocation}" HorizontalAlignment="Stretch" PlaceholderText="Select default storage location...">
                                                      <ComboBox.ItemTemplate>
                                                          <DataTemplate>
                                                              <TextBlock Text="{Binding Name}" />
                                                          </DataTemplate>
                                                      </ComboBox.ItemTemplate>
                                                  </ComboBox>
                                                  <Button Grid.Column="1" Content="Clear" Command="{Binding ClearDefaultLocationCommand}" Margin="5,0,0,0" Padding="8,4" FontSize="11"/>
                                              </Grid>
                                          </StackPanel>

                                          <!-- Current Stock Breakdown across Locations -->
                                          <StackPanel Spacing="5" Margin="0,10,0,0">
                                              <TextBlock Text="Stock by Location" FontSize="12" FontWeight="SemiBold"/>
                                              <TextBlock Text="Current stock quantities distributed across all locations." FontSize="11" Foreground="Gray"/>
                                              <DataGrid ItemsSource="{Binding ProductLocationStocks}"
                                                        AutoGenerateColumns="False"
                                                        IsReadOnly="True"
                                                        GridLinesVisibility="Horizontal"
                                                        MaxHeight="180"
                                                        BorderThickness="1"
                                                        BorderBrush="{DynamicResource BorderColor}"
                                                        Background="{DynamicResource CardBackgroundColor}">
                                                  <DataGrid.Columns>
                                                      <DataGridTextColumn Header="Location" Binding="{Binding LocationName}" Width="*" />
                                                      <DataGridTextColumn Header="Type" Binding="{Binding LocationType}" Width="100" />
                                                      <DataGridTextColumn Header="On Hand" Binding="{Binding Quantity}" Width="80" />
                                                      <DataGridTextColumn Header="Reorder Point" Binding="{Binding ReorderPoint}" Width="100" />
                                                  </DataGrid.Columns>
                                              </DataGrid>
                                          </StackPanel>
                                      </StackPanel>
                                  </TabItem>

                                 <TabItem Header="Additional Fields" IsVisible="{Binding HasCustomFields}">
                                     <StackPanel Spacing="15" Margin="0,10,0,0">
                                         <views:CustomFieldsPanel ItemsSource="{Binding ProductCustomFields}" />
                                     </StackPanel>
                                 </TabItem>
                             </TabControl>

                            <!-- 2. Stock Adjustment Form -->
                            <StackPanel Spacing="15" IsVisible="{Binding IsStockMode}">
                                <TextBlock Text="{Binding Language.Resources[Inv_MovementType]}" FontSize="12" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding MovementTypes}" SelectedItem="{Binding SelectedMovementType}" HorizontalAlignment="Stretch"/>
                                
                                <TextBlock Text="{Binding Language.Resources[Inv_Quantity]}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBox Watermark="{Binding Language.Resources[Inv_Quantity]}" Text="{Binding AdjustmentQuantity}" />

                                <!-- Batch Financials -->
                                <StackPanel IsVisible="{Binding IsMovementIn}" Spacing="5">
                                    <TextBlock Text="{Binding Language.Resources[Inv_CostPerUnit]}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBox Watermark="{Binding Language.Resources[Inv_CostPerUnit]}" Text="{Binding AdjustmentCostPerUnit}" />
                                </StackPanel>

                                <StackPanel IsVisible="{Binding IsMovementOut}" Spacing="5">
                                    <TextBlock Text="{Binding Language.Resources[Inv_SellingPrice]}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBox Watermark="{Binding Language.Resources[Inv_SellingPrice]}" Text="{Binding AdjustmentUnitPrice}" />
                                </StackPanel>

                                <StackPanel IsVisible="{Binding ShowBatchFields}" Spacing="5">
                                    <TextBlock Text="Lot / Batch Number" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBox Watermark="Required for lot-tracked products" Text="{Binding AdjustmentBatchNumber}"/>
                                    <TextBlock Text="Expiry Date" FontSize="12" FontWeight="SemiBold"/>
                                    <CalendarDatePicker SelectedDate="{Binding AdjustmentExpiryDate}"/>
                                </StackPanel>

                                <StackPanel IsVisible="{Binding ShowSerialFields}" Spacing="5">
                                    <TextBlock Text="Serial Numbers (comma-separated)" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBox Watermark="SN-001, SN-002" Text="{Binding AdjustmentSerialNumbers}" AcceptsReturn="True" MinHeight="60"/>
                                </StackPanel>
                                
                                <TextBlock Text="{Binding Language.Resources[Inv_Reason]}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBox Watermark="{Binding Language.Resources[Inv_Reason]}" Text="{Binding AdjustmentReason}" />
                            </StackPanel>

                            <!-- Common Error Message -->
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF5252" TextWrapping="Wrap" IsVisible="{Binding HasError}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="Cancel" Command="{Binding CancelPaneCommand}" Padding="14,6" CornerRadius="6"/>
                        <Button Content="Save" Command="{Binding SaveProductCommand}" Background="{DynamicResource NavActiveBgColor}" Foreground="{DynamicResource NavActiveTextColor}" Padding="16,8" FontWeight="SemiBold" CornerRadius="6"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- UoM Search More Modal Overlay (Layer 2) -->
        <Grid Background="#7F000000" IsVisible="{Binding IsUomSearchMoreModalOpen}" ZIndex="20" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="{DynamicResource ContentBackgroundColor}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Width="450"
                    MaxHeight="500"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    BoxShadow="0 8 32 0 #40000000"
                    Padding="20">
                <Grid RowDefinitions="Auto, Auto, *, Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                        <TextBlock Text="Units of Measure" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryColor}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Command="{Binding CancelSearchMoreCommand}"
                                Content="✕" FontSize="16" Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource TextSecondaryColor}" Padding="6,2" Cursor="Hand"/>
                    </Grid>
                    
                    <Button Grid.Row="1" Content="Create New Unit" Command="{Binding OpenCreateUnitFromSearchMoreCommand}" Background="{DynamicResource NavActiveBgColor}" Foreground="{DynamicResource NavActiveTextColor}" Padding="12,6" FontWeight="SemiBold" CornerRadius="6" HorizontalAlignment="Right" Margin="0,0,0,10"/>
                    
                    <ScrollViewer Grid.Row="2" MaxHeight="300" Margin="0,0,0,10">
                        <ListBox ItemsSource="{Binding AllProductUnits}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*, Auto, Auto" Margin="5">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="{Binding Quantity, StringFormat='Qty Ratio: {0}'}" FontSize="11" Foreground="Gray"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Content="Group POS" IsChecked="{Binding GroupInPOS}" IsEnabled="False" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Content="Select" Command="{Binding $parent[UserControl].((vm:InventoryViewModel)DataContext).SelectUnitFromSearchMoreCommand}" CommandParameter="{Binding .}" FontSize="11" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                    
                    <Button Grid.Row="3" Content="Close" Command="{Binding CancelSearchMoreCommand}" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Create Unit Modal Overlay (Layer 3) -->
        <Grid Background="#7F000000" IsVisible="{Binding IsCreateUnitModalOpen}" ZIndex="30" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="{DynamicResource ContentBackgroundColor}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Width="400"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    BoxShadow="0 8 32 0 #40000000"
                    Padding="20">
                <StackPanel Spacing="15">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Text="Create New Unit" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryColor}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Command="{Binding CancelCreateUnitCommand}"
                                Content="✕" FontSize="16" Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource TextSecondaryColor}" Padding="6,2" Cursor="Hand"/>
                    </Grid>
                    
                    <StackPanel Spacing="5">
                        <TextBlock Text="Unit Name" FontSize="12"/>
                        <TextBox Watermark="e.g. Dozen" Text="{Binding NewUnitName}"/>
                    </StackPanel>
                    
                    <StackPanel Spacing="5">
                        <TextBlock Text="Quantity Ratio" FontSize="12"/>
                        <TextBox Watermark="1.0" Text="{Binding NewUnitQuantity}"/>
                    </StackPanel>
                    
                    <StackPanel Spacing="5">
                        <TextBlock Text="Reference Unit (Optional)" FontSize="12"/>
                        <ComboBox ItemsSource="{Binding CleanUnitNames}" SelectedItem="{Binding NewUnitReferenceUnit}" HorizontalAlignment="Stretch" PlaceholderText="Select reference unit..."/>
                    </StackPanel>
                    
                    <CheckBox Content="Group products in POS" IsChecked="{Binding NewUnitGroupInPOS}"/>
                    
                    <TextBlock Text="{Binding NewUnitErrorMessage}" Foreground="#EF4444" TextWrapping="Wrap" IsVisible="{Binding NewUnitErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Cancel" Command="{Binding CancelCreateUnitCommand}" Padding="14,6" CornerRadius="6"/>
                        <Button Content="Save" Command="{Binding SaveNewUnitCommand}" Background="{DynamicResource NavActiveBgColor}" Foreground="{DynamicResource NavActiveTextColor}" Padding="14,6" FontWeight="SemiBold" CornerRadius="6"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Create Category Modal Overlay (Layer 4) -->
        <Grid Background="#7F000000" IsVisible="{Binding IsCreateCategoryModalOpen}" ZIndex="30" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="{DynamicResource ContentBackgroundColor}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Width="400"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    BoxShadow="0 8 32 0 #40000000"
                    Padding="20">
                <StackPanel Spacing="15">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Text="Create New Category" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryColor}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Command="{Binding CancelCreateCategoryCommand}"
                                Content="✕" FontSize="16" Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource TextSecondaryColor}" Padding="6,2" Cursor="Hand"/>
                    </Grid>
                    
                    <StackPanel Spacing="5">
                        <TextBlock Text="Category Name" FontSize="12"/>
                        <TextBox Watermark="e.g. Electronics" Text="{Binding NewCategoryName}"/>
                    </StackPanel>
                    
                    <StackPanel Spacing="5">
                        <TextBlock Text="Description" FontSize="12"/>
                        <TextBox Watermark="Category description" Text="{Binding NewCategoryDescription}" Height="60" TextWrapping="Wrap"/>
                    </StackPanel>
                    
                    <TextBlock Text="{Binding NewCategoryErrorMessage}" Foreground="#EF4444" TextWrapping="Wrap" IsVisible="{Binding NewCategoryErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Cancel" Command="{Binding CancelCreateCategoryCommand}" Padding="14,6" CornerRadius="6"/>
                        <Button Content="Save" Command="{Binding SaveNewCategoryCommand}" Background="{DynamicResource NavActiveBgColor}" Foreground="{DynamicResource NavActiveTextColor}" Padding="14,6" FontWeight="SemiBold" CornerRadius="6"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Create Tax Modal Overlay (Layer 5) -->
        <Grid Background="#7F000000" IsVisible="{Binding IsCreateTaxModalOpen}" ZIndex="30" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="{DynamicResource ContentBackgroundColor}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Width="450"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    BoxShadow="0 8 32 0 #40000000"
                    Padding="20">
                <ScrollViewer MaxHeight="450">
                    <StackPanel Spacing="15">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Text="Create New Sales Tax" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryColor}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Command="{Binding CancelCreateTaxCommand}"
                                    Content="✕" FontSize="16" Background="Transparent" BorderThickness="0"
                                    Foreground="{DynamicResource TextSecondaryColor}" Padding="6,2" Cursor="Hand"/>
                        </Grid>
                        
                        <StackPanel Spacing="5">
                            <TextBlock Text="Tax Name" FontSize="12"/>
                            <TextBox Watermark="e.g. VAT 15%" Text="{Binding NewTaxName}"/>
                        </StackPanel>
                        
                        <Grid ColumnDefinitions="*, 15, *">
                            <StackPanel Grid.Column="0" Spacing="5">
                                <TextBlock Text="Amount" FontSize="12"/>
                                <TextBox Watermark="0.00" Text="{Binding NewTaxAmount}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="5">
                                <TextBlock Text="Computation" FontSize="12"/>
                                <ComboBox ItemsSource="{Binding TaxComputationOptions}" SelectedItem="{Binding NewTaxComputation}" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*, 15, *">
                            <StackPanel Grid.Column="0" Spacing="5">
                                <TextBlock Text="Scope" FontSize="12"/>
                                <ComboBox ItemsSource="{Binding TaxScopeOptions}" SelectedItem="{Binding NewTaxScope}" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="5">
                                <TextBlock Text="Included in Price" FontSize="12"/>
                                <ComboBox ItemsSource="{Binding TaxIncludedOptions}" SelectedItem="{Binding NewTaxIncludedInPrice}" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="5">
                            <TextBlock Text="Label on Invoice" FontSize="12"/>
                            <TextBox Watermark="e.g. VAT (15%)" Text="{Binding NewTaxLabelOnInvoice}"/>
                        </StackPanel>
                        
                        <StackPanel Spacing="5">
                            <TextBlock Text="Description" FontSize="12"/>
                            <TextBox Watermark="Tax description" Text="{Binding NewTaxDescription}" Height="50" TextWrapping="Wrap"/>
                        </StackPanel>
                        
                        <TextBlock Text="{Binding NewTaxErrorMessage}" Foreground="#EF4444" TextWrapping="Wrap" IsVisible="{Binding NewTaxErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Content="Cancel" Command="{Binding CancelCreateTaxCommand}" Padding="14,6" CornerRadius="6"/>
                            <Button Content="Save" Command="{Binding SaveNewSalesTaxCommand}" Background="{DynamicResource NavActiveBgColor}" Foreground="{DynamicResource NavActiveTextColor}" Padding="14,6" FontWeight="SemiBold" CornerRadius="6"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Product Transaction History Modal -->
        <Grid Background="#7F000000" IsVisible="{Binding IsHistoryModalOpen}" ZIndex="20" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="{DynamicResource ContentBackgroundColor}" CornerRadius="12" MinWidth="900" MinHeight="520" Width="1100" Height="640"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24" BoxShadow="0 10 40 0 #44000000">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Product Transaction History" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text="{Binding HistoryProductTitle}" FontSize="14" Foreground="#007ACC" FontWeight="SemiBold"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Command="{Binding CloseHistoryModalCommand}" Background="Transparent" BorderThickness="0" FontSize="16"/>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding HistoryStatusMessage}" Foreground="Gray" FontSize="12" Margin="0,8,0,12"/>

                    <!-- Replenishment forecast: on hand + incoming (open POs) - outgoing (open SOs) -->
                    <StackPanel Grid.Row="2" Spacing="6" Margin="0,0,0,12">
                        <Grid ColumnDefinitions="*,*,*,*">
                            <Border Background="#E3F2FD" Padding="10" CornerRadius="8" Margin="0,0,6,0">
                                <StackPanel><TextBlock Text="On Hand" FontSize="11" Foreground="Gray"/><TextBlock Text="{Binding CurrentForecast.OnHand}" FontWeight="Bold" FontSize="16"/></StackPanel>
                            </Border>
                            <Button Grid.Column="1" Command="{Binding ToggleIncomingBreakdownCommand}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,6,0" HorizontalContentAlignment="Stretch">
                                <Border Background="#E8F5E9" Padding="10" CornerRadius="8">
                                    <StackPanel><TextBlock Text="Incoming (click for sources)" FontSize="11" Foreground="Gray"/><TextBlock Text="{Binding CurrentForecast.Incoming}" FontWeight="Bold" FontSize="16" Foreground="#2E7D32"/></StackPanel>
                                </Border>
                            </Button>
                            <Button Grid.Column="2" Command="{Binding ToggleOutgoingBreakdownCommand}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,6,0" HorizontalContentAlignment="Stretch">
                                <Border Background="#FFEBEE" Padding="10" CornerRadius="8">
                                    <StackPanel><TextBlock Text="Outgoing (click for sources)" FontSize="11" Foreground="Gray"/><TextBlock Text="{Binding CurrentForecast.Outgoing}" FontWeight="Bold" FontSize="16" Foreground="#C62828"/></StackPanel>
                                </Border>
                            </Button>
                            <Border Grid.Column="3" Background="#FFF8E1" Padding="10" CornerRadius="8">
                                <StackPanel><TextBlock Text="Forecasted Available" FontSize="11" Foreground="Gray"/><TextBlock Text="{Binding CurrentForecast.ForecastedAvailable}" FontWeight="Bold" FontSize="16"/></StackPanel>
                            </Border>
                        </Grid>

                        <Border IsVisible="{Binding IsIncomingBreakdownOpen}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="10" Background="{DynamicResource ContentBackgroundColor}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Incoming from these purchase orders:" FontSize="11" FontWeight="SemiBold" Foreground="Gray"/>
                                <ItemsControl ItemsSource="{Binding CurrentForecast.IncomingSources}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding $parent[UserControl].((vm:InventoryViewModel)DataContext).OpenReplenishmentSourceCommand}" CommandParameter="{Binding .}"
                                                    Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Padding="4">
                                                <Grid ColumnDefinitions="140, 100, 80, *">
                                                    <TextBlock Text="{Binding DocumentNumber}" Foreground="#007ACC" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="Gray" FontSize="11"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Quantity, StringFormat='+{0}'}" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Date, StringFormat='{}{0:yyyy-MM-dd}'}" Foreground="Gray" FontSize="11" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border IsVisible="{Binding IsOutgoingBreakdownOpen}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="10" Background="{DynamicResource ContentBackgroundColor}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Outgoing on these sales orders:" FontSize="11" FontWeight="SemiBold" Foreground="Gray"/>
                                <ItemsControl ItemsSource="{Binding CurrentForecast.OutgoingSources}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding $parent[UserControl].((vm:InventoryViewModel)DataContext).OpenReplenishmentSourceCommand}" CommandParameter="{Binding .}"
                                                    Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Padding="4">
                                                <Grid ColumnDefinitions="140, 100, 80, *">
                                                    <TextBlock Text="{Binding DocumentNumber}" Foreground="#007ACC" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="Gray" FontSize="11"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Quantity, StringFormat='-{0}'}" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Date, StringFormat='{}{0:yyyy-MM-dd}'}" Foreground="Gray" FontSize="11" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="3" ColumnDefinitions="*,16,*">
                        <StackPanel Grid.Column="0" Spacing="8">
                            <TextBlock Text="Stock Movements" FontWeight="SemiBold"/>
                            <DataGrid ItemsSource="{Binding ProductHistoryEvents}" SelectedItem="{Binding SelectedHistoryEvent}" AutoGenerateColumns="False" IsReadOnly="True" Height="420">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date" Binding="{Binding Movement.Date, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="130"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding Category}" Width="110"/>
                                    <DataGridTextColumn Header="Qty" Binding="{Binding QuantityDisplay}" Width="80"/>
                                    <DataGridTextColumn Header="Document" Binding="{Binding DocumentReference}" Width="100"/>
                                    <DataGridTextColumn Header="Reason" Binding="{Binding Movement.Reason}" Width="*"/>
                                    <DataGridTextColumn Header="User" Binding="{Binding Movement.Username}" Width="90"/>
                                    <DataGridTextColumn Header="Journals" Binding="{Binding JournalLineCount}" Width="70"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="8">
                            <TextBlock Text="Linked Journal Entries" FontWeight="SemiBold"/>
                            <TextBlock Text="Select a movement on the left to see sales, purchase, adjustment, and other GL postings." FontSize="11" Foreground="Gray" TextWrapping="Wrap"/>
                            <DataGrid ItemsSource="{Binding HistoryJournalLines}" AutoGenerateColumns="False" IsReadOnly="True" Height="360">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='{}{0:yyyy-MM-dd}'}" Width="100"/>
                                    <DataGridTextColumn Header="Entry" Binding="{Binding EntryNumber}" Width="110"/>
                                    <DataGridTextColumn Header="Account" Binding="{Binding AccountDisplay}" Width="*"/>
                                    <DataGridTextColumn Header="Partner" Binding="{Binding PartnerName}" Width="100"/>
                                    <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="*"/>
                                    <DataGridTextColumn Header="Debit" Binding="{Binding Debit, StringFormat='{}{0:N2}'}" Width="80"/>
                                    <DataGridTextColumn Header="Credit" Binding="{Binding Credit, StringFormat='{}{0:N2}'}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Orientation="Horizontal" Spacing="20">
                                <TextBlock Text="{Binding HistoryJournalTotalDebit, StringFormat='Total Debit: {0:N2}'}"/>
                                <TextBlock Text="{Binding HistoryJournalTotalCredit, StringFormat='Total Credit: {0:N2}'}"/>
                                <TextBlock Text="{Binding CurrencySymbol}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Button Grid.Row="4" Content="Close" Command="{Binding CloseHistoryModalCommand}" HorizontalAlignment="Right" Margin="0,16,0,0" Width="100"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
